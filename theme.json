{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "forest",
          "color": "#1E4A1C",
          "name": "Forest Green"
        },
        {
          "slug": "forest-2",
          "color": "#2B5A28",
          "name": "Forest Deep"
        },
        {
          "slug": "matcha",
          "color": "#7DB92E",
          "name": "Matcha Green"
        },
        {
          "slug": "lime",
          "color": "#C8F03C",
          "name": "Vibrant Lime"
        },
        {
          "slug": "mint-light",
          "color": "#E7F4D6",
          "name": "Mint Light"
        },
        {
          "slug": "pink",
          "color": "#F6C4D2",
          "name": "Blossom Pink"
        },
        {
          "slug": "pink-pale",
          "color": "#FDE3EA",
          "name": "Blossom Pale"
        },
        {
          "slug": "ink",
          "color": "#10240F",
          "name": "Matcha Ink"
        },
        {
          "slug": "ink-soft",
          "color": "#4B5B4A",
          "name": "Ink Soft"
        },
        {
          "slug": "on-dark",
          "color": "#E9F6D8",
          "name": "On Dark Light"
        },
        {
          "slug": "surface",
          "color": "#FFFFFF",
          "name": "Pure White"
        },
        {
          "slug": "bg-page",
          "color": "#E6E6E6",
          "name": "Page Grey"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Instrument Serif\", \"Cormorant Garamond\", Georgia, serif",
          "slug": "instrument-serif",
          "name": "Instrument Serif"
        },
        {
          "fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "slug": "inter",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        {
          "slug": "eyebrow",
          "size": "0.6875rem",
          "name": "Eyebrow"
        },
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium (Body)"
        },
        {
          "slug": "large",
          "size": "1.125rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "Extra Large"
        },
        {
          "slug": "h2",
          "size": "clamp(1.85rem, 4.2vw, 3.75rem)",
          "name": "Heading 2"
        },
        {
          "slug": "step",
          "size": "clamp(2.5rem, 7.5vw, 7.5rem)",
          "name": "Step Display"
        },
        {
          "slug": "giant",
          "size": "clamp(3.25rem, 11vw, 14rem)",
          "name": "Giant Serif"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg-page)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--instrument-serif)",
          "fontWeight": "400"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--giant)",
          "lineHeight": "0.88"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h2)",
          "lineHeight": "1.08"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--forest)",
          "text": "var(--wp--preset--color--surface)"
        },
        "border": {
          "radius": "999px"
        }
      }
    }
  }
}
